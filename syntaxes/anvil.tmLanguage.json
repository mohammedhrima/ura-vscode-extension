{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "anvil",
  "scopeName": "source.anvil",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#handlers" },
    { "include": "#fields" },
    { "include": "#on-method" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.anvil",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.anvil",
      "begin": "\"",
      "end": "\""
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.anvil",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "handlers": {
      "patterns": [
        {
          "comment": "success = { ... } / failure = { ... } inside .on(...)",
          "name": "keyword.other.handler.anvil",
          "match": "\\b(success|failure)\\b(?=\\s*=)"
        }
      ]
    },

    "fields": {
      "patterns": [
        {
          "comment": "record fields produced by a command: .flag .code .out .err",
          "match": "(\\.)(flag|code|out|err)\\b",
          "captures": {
            "1": { "name": "keyword.operator.anvil" },
            "2": { "name": "support.variable.property.anvil" }
          }
        }
      ]
    },

    "on-method": {
      "patterns": [
        {
          "comment": ".on(...) — run a command / dispatch on a record",
          "match": "(\\.)(on)\\b",
          "captures": {
            "1": { "name": "keyword.operator.anvil" },
            "2": { "name": "support.function.builtin.anvil" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.anvil",
          "match": "\\b(fn|for|in|loop|if|elif|else|while)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.anvil",
          "match": "\\b(Cmd|File)\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.anvil",
          "match": "\\b(output|okput|errput|warnput|infoput|walk|read|write|diff|replace|setenv|setThreadPool|enableDebug)\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.anvil",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.anvil",
          "match": "[+\\-*/=.]"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.anvil",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
      ]
    }
  }
}